# Copy these keys into Streamlit Community Cloud → App settings → Secrets.
# Do not commit a real .streamlit/secrets.toml file.
LLM_PROVIDER = "mistral"
ALLOW_CLOUD_FALLBACK = "true"
MISTRAL_API_KEY = "replace-in-streamlit-secrets"
MISTRAL_MODEL = "mistral-medium-latest"
GEMINI_API_KEY = "replace-in-streamlit-secrets"
GEMINI_MODEL = "gemini-2.5-flash"
